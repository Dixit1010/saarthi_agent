# ==========================================
# Saarthi AI — Environment Configuration
# ==========================================

# Database
# Default: Local SQLite (Zero-config, no Docker required)
DATABASE_URL="file:./dev.db"
# For production PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/saarthi?schema=public"

# API Server
PORT=4000
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"
JWT_SECRET="saarthi-dev-super-secret-jwt-key-minimum-32-chars"
SESSION_SECRET="saarthi-session-secret-cookie-entropy-key-32"

# AI Provider Configuration
# Supported: gemini | openai | groq
AI_PROVIDER="gemini"

# Google Gemini API Key
GEMINI_API_KEY=""

# OpenAI (Optional / Fallback)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"

# Groq (Optional / Low-latency inference)
GROQ_API_KEY=""

# Web Client URL
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# ==========================================
# Telegram Bot Configuration (100% Free & Local)
# ==========================================
# 1. Create a bot with @BotFather to get your token
TELEGRAM_BOT_TOKEN=""
# 2. Find your numeric User ID using @userinfobot (used to authorize commands)
TELEGRAM_ALLOWED_USER_ID=""
# 3. Target Chat ID for notifications (usually same as your numeric User ID for 1-on-1 private chat)
TELEGRAM_CHAT_ID=""
